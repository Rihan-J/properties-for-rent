# Database — Use Neon pooled connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/apnastay?sslmode=require

# JWT
JWT_SECRET=your-random-64-char-secret-here

# Server
PORT=5000
NODE_ENV=development

# CORS — your frontend URL
CORS_ORIGIN=http://localhost:3000

# Cloudinary — get these from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare Turnstile — get these from https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET=your-turnstile-secret-key

# Resend — get this from https://resend.com → API Keys
RESEND_API_KEY=your-resend-api-key

# Frontend URL — used for email verification links
FRONTEND_URL=http://localhost:3000

